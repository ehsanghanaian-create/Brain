# Copy to .env and fill in. NEVER commit .env.

# --- WordPress (read-only; Application Password, NOT the admin password) ---
WP_URL=https://example.com
WP_USERNAME=
WP_APP_PASSWORD=

# --- Google Search Console (OAuth "Desktop app" client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL-prefix property: https://example.com/   or Domain property: sc-domain:example.com
GSC_PROPERTY=https://example.com/
# Where the OAuth refresh token is cached (git-ignored)
GSC_TOKEN_PATH=tokens/gsc_token.json

# --- Obsidian Local REST API (OPTIONAL; vault is written directly as files) ---
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=

# --- Storage ---
DATABASE_PATH=data/seo.db
RAW_DATA_DIR=data/raw
OBSIDIAN_VAULT_PATH=obsidian/SEO-Knowledge-Graph

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- SEO Brain API (FastAPI, Phase 2+) ---
# Optional bearer token required as X-API-Token by the API; the Next.js proxy injects it server-side (frontend/.env.local).
API_TOKEN=
# Monthly AI budget etc. are configured per site in the UI (site_settings); provider API keys are NEVER env vars —
# they are entered once in AI Models → stored DPAPI-encrypted by the SecretStore under data/secrets/ (git-ignored).
